# Copy this file to ".env" and fill in your values.
# In production (Render) these are provided automatically — you only need
# this for local development with a real Postgres database.

# Leave DATABASE_URL unset to use the built-in local SQLite database.
# To use a local Postgres instance instead, set it, e.g.:
# DATABASE_URL=postgres://user:password@localhost:5432/amyskitchen

JWT_SECRET=change-me-to-a-long-random-string

# Admin account (seeded on server start). Without these, no /admin access exists.
ADMIN_EMAIL=admin@amys.kitchen
ADMIN_PASSWORD=change-me-admin-password

# Password reset: in production the reset token is only returned in dev (NODE_ENV
# != production). To email real reset links, configure an SMTP service.
# When SMTP_HOST is set, a reset email is sent; otherwise the token is returned
# in the API response (dev only) so you can test locally.

# Public base URL used in reset emails, e.g. https://amys-kitchen.onrender.com
APP_BASE_URL=http://localhost:3001

# SMTP (optional). Leave unset to skip real emails in dev.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Amy's Kitchen <no-reply@amyskitchen.com>
